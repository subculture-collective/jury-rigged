# -----------------------------------------------------------------------------
# Core server
# -----------------------------------------------------------------------------

PORT=3000
LOG_LEVEL=info

# Set to 1 when behind one reverse proxy (Docker ingress, Nginx, Traefik, etc.)
TRUST_PROXY=1

# Docker host binding. Compose overrides PORT inside the API container.
API_BIND_ADDR=127.0.0.1
API_HOST_PORT=3001


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

POSTGRES_PASSWORD=change_this_now
DATABASE_URL=postgresql://postgres:change_this_now@localhost:55432/juryrigged

# Optional alias used by some local scripts/tools.
JURY_RIGGED_DATABASE_URL=postgresql://postgres:change_this_now@localhost:55432/juryrigged


# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------

OPENROUTER_API_KEY=
LLM_PROVIDER=llama-line
LLM_MODEL=deepseek/deepseek-chat-v3-0324:free
LLM_MODELS=
LLM_MOCK=false

# Preferred local broker path. Phoenix tracing is handled by llama-line downstream.
LLAMA_LINE_BASE_URL=http://10.0.0.50:11434
LLAMA_LINE_API_KEY=
LLAMA_LINE_MODEL=qwen2.5-coder:14b

# Ollama-compatible aliases used by sibling projects/tools.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=


# -----------------------------------------------------------------------------
# LLM audit logging
# -----------------------------------------------------------------------------

LLM_AUDIT_ENABLED=false
LLM_AUDIT_BODY_PERSISTENCE=off
LLM_AUDIT_MAX_BODY_CHARS=50000
LLM_AUDIT_RETENTION_DAYS=7


# -----------------------------------------------------------------------------
# Simple admin auth
# Protects /operator and admin API routes when ADMIN_PASSWORD is set.
# -----------------------------------------------------------------------------

ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
ADMIN_COOKIE_SECURE=false


# -----------------------------------------------------------------------------
# Vote windows + spam safety
# -----------------------------------------------------------------------------

VERDICT_VOTE_WINDOW_MS=20000
SENTENCE_VOTE_WINDOW_MS=20000
VOTE_SPAM_MAX_VOTES_PER_WINDOW=10
VOTE_SPAM_WINDOW_MS=60000
VOTE_SPAM_DUPLICATE_WINDOW_MS=5000


# -----------------------------------------------------------------------------
# Generation budgets
# -----------------------------------------------------------------------------

WITNESS_MAX_TOKENS=150
WITNESS_MAX_SECONDS=30
WITNESS_TOKENS_PER_SECOND=3
WITNESS_TRUNCATION_MARKER=[The witness was cut off by the judge.]
JUDGE_RECAP_CADENCE=2

ROLE_MAX_TOKENS_DEFAULT=260
ROLE_MAX_TOKENS_JUDGE=220
ROLE_MAX_TOKENS_PROSECUTOR=220
ROLE_MAX_TOKENS_DEFENSE=220
ROLE_MAX_TOKENS_WITNESS=160
ROLE_MAX_TOKENS_BAILIFF=120
TOKEN_COST_PER_1K_USD=0.002


# -----------------------------------------------------------------------------
# TTS + broadcast automation
# -----------------------------------------------------------------------------

TTS_PROVIDER=noop
BROADCAST_PROVIDER=noop
OBS_WEBSOCKET_URL=ws://localhost:4455
OBS_WEBSOCKET_PASSWORD=


# -----------------------------------------------------------------------------
# Replay + recording
# -----------------------------------------------------------------------------

RECORDINGS_DIR=recordings
REPLAY_FILE=
REPLAY_SPEED=1


# -----------------------------------------------------------------------------
# Twitch integration
# -----------------------------------------------------------------------------

TWITCH_CHANNEL=
TWITCH_BOT_USERNAME=
TWITCH_BOT_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REFRESH_TOKEN=

# Future/EventSub-specific secret. Currently not used by the app.
TWITCH_EVENTSUB_SECRET=
